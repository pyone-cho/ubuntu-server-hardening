# Copy to .env and customize before running scripts.
# Usage: source .env && sudo -E ./scripts/harden-server.sh

# SSH port (default: 22)
SSH_PORT=22

# Primary admin user (must exist with sudo access before locking root)
ADMIN_USER="ubuntu"

# Lock the root account password (1 = yes, 0 = no)
LOCK_ROOT=1

# Comma-separated list of users allowed to SSH (empty = no AllowUsers restriction)
# Recommended: restrict to your admin user only
SSH_ALLOWED_USERS="ubuntu"

# Outline management API port (set after install-outline.sh, or leave empty)
# The installer prints this port — add it here before re-running hardening if needed.
OUTLINE_API_PORT=""

# Additional TCP ports to allow through UFW (comma-separated)
# Example: EXTRA_TCP_PORTS="12345,54321"
EXTRA_TCP_PORTS=""

# Set to 1 to skip apt upgrade (not recommended)
SKIP_UPGRADE=0

# Set to 1 for non-interactive mode (auto-confirms prompts)
NONINTERACTIVE=0
